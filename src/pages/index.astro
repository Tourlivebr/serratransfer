---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/HomeHero.astro';
import NatalLuzBanner from '../components/NatalLuzBanner.astro';
import CarrosselPasseios from '../components/CarrosselPasseios.astro';
import CarrosselPasseiosReceptivo from '../components/CarrosselPasseiosReceptivo.astro';
import Depoimentos from '../components/Depoimentos.astro';
import FormularioContato from '../components/FormularioContato.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

const seoDescription = "Passeios Gramado Canela - O seu guia completo de turismo em Gramado e Canela! Translados, passeios, ingressos para atrações e muito mais na Serra Gaúcha. Reserve já!";
const seoKeywords = [
  "turismo Gramado",
  "turismo Canela",
  "translado Gramado",
  "translado Canela",
  "ingressos Gramado",
  "passeios Serra Gaúcha",
  "Passeios Gramado Canela",
  "Gramado RS",
  "Canela RS"
];
---

<BaseLayout 
  title="Passeios Gramado Canela | Turismo em Gramado e Canela - Serra Gaúcha" 
  description={seoDescription}
  keywords={seoKeywords}
  image="/images/logo_serra.png"
>
  <Header home />
  
  <!-- Seção Hero -->
  <main class="home-content bg-primary-50 dark:bg-dark-900">
  <HomeHero />
  
  <!-- Seção de Passeios e Receptivo -->
  <section id="passeios">
    <CarrosselPasseiosReceptivo />
  </section>
  
  <!-- Seção de Ingressos e Atrações -->
  <NatalLuzBanner />

  <section id="ingressos">
    <CarrosselPasseios />
  </section>
  
  <!-- Seção Depoimentos -->
  <section id="depoimentos">
    <Depoimentos />
  </section>
  
  <!-- Seção Contato -->
  <section id="contato">
    <FormularioContato />
  </section>
  <Faq />
  
  <!-- Footer -->
  </main>
  <Footer />
</BaseLayout>
