---
const message = 'Olá! Quero reservar meus passeios para o Natal Luz em Gramado e Canela.';
const whatsappUrl = 'https://wa.me/5554992065626?text=' + encodeURIComponent(message);
---

<section class="christmas-banner" aria-labelledby="christmas-title">
  <img class="christmas-background" src="/images/natal-luz-banner.jpg" alt="" width="1983" height="793" loading="lazy" decoding="async" />
  <div class="christmas-overlay" aria-hidden="true"></div>
  <div class="christmas-content container mx-auto px-4">
    <div class="christmas-copy">
      <p class="christmas-eyebrow"><span aria-hidden="true">&#10022;</span> Viva a magia de Gramado e Canela</p>
      <h2 id="christmas-title">Reserve seus passeios<br />para o <span>Natal Luz</span></h2>
      <p class="christmas-description">Passeios e transfers para aproveitar cada momento da sua viagem.</p>
      <a class="christmas-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
        Fale pelo WhatsApp
        <span aria-hidden="true">&#8594;</span>
      </a>
    </div>
    <ul class="christmas-benefits" aria-label="Nosso atendimento">
      <li><span aria-hidden="true">&#10003;</span> Roteiros personalizados</li>
      <li><span aria-hidden="true">&#10003;</span> Passeios no seu ritmo</li>
      <li><span aria-hidden="true">&#10003;</span> Atendimento pelo WhatsApp</li>
      <li><span aria-hidden="true">&#10003;</span> Sua viagem bem cuidada</li>
    </ul>
  </div>
</section>

<style>
  .christmas-banner{position:relative;isolation:isolate;overflow:hidden;background:#032e21;color:#fffaf0}
  .christmas-background,.christmas-overlay{position:absolute;inset:0;width:100%;height:100%;z-index:-1}
  .christmas-background{object-fit:cover;object-position:center 52%}
  .christmas-overlay{background:linear-gradient(90deg,rgba(0,25,15,.68),rgba(0,25,15,.76) 40%,rgba(0,25,15,.35))}
  .christmas-content{display:flex;align-items:center;justify-content:space-between;gap:48px;min-height:360px;padding-top:48px;padding-bottom:48px;max-width:1200px}
  .christmas-copy{max-width:650px}
  .christmas-eyebrow{display:flex;align-items:center;gap:10px;color:#f5d68c;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px}
  .christmas-eyebrow span{font-size:24px}
  h2{font-size:clamp(30px,3vw,44px);font-weight:700;line-height:1.15;margin:0}
  h2 span{display:inline-block;font-family:Georgia,serif;color:#f5d68c;font-size:1.5em;line-height:1.15}
  .christmas-description{font-size:15px;line-height:1.65;max-width:430px;margin:18px 0 24px}
  .christmas-button{display:inline-flex;align-items:center;gap:12px;padding:15px 24px;background:#087d35;color:white;border:1px solid #73c985;border-radius:999px;font-weight:700;box-shadow:0 5px 24px #001b0340;transition:background .2s}
  .christmas-button:hover{background:#09662d}
  .christmas-button:focus-visible{outline:3px solid #f5d68c;outline-offset:5px}
  .christmas-button svg{width:24px;height:24px;flex-shrink:0}
  .christmas-button>span{margin-left:4px;font-size:22px}
  .christmas-benefits{list-style:none;display:grid;gap:22px;background:#fffaf0f2;color:#183b2a;padding:28px;border-radius:20px;min-width:290px;font-size:14px;box-shadow:0 12px 30px #0002}
  .christmas-benefits li{display:flex;align-items:center;gap:12px}
  .christmas-benefits span{font-weight:700;color:#087d35}
  @media(max-width:767px){.christmas-content{flex-direction:column;gap:28px;align-items:stretch;padding:40px 24px}.christmas-copy{text-align:center;margin:auto}.christmas-eyebrow{justify-content:center;font-size:10px;letter-spacing:.08em}h2{font-size:30px}.christmas-description{font-size:14px}.christmas-button{font-size:14px;padding:14px 20px}.christmas-benefits{min-width:0;width:min(100%,370px);margin:auto;gap:16px;padding:22px}.christmas-background{object-position:center}.christmas-overlay{background:#002215b8}}
</style>
