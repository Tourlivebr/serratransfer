  </div>
  <svg class="hero-wave text-primary-50 dark:text-dark-900" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 45C180 0 360 0 540 45S900 90 1080 45S1320 0 1440 30V100H0Z" fill="currentColor" />
