---

<section id="passeios-receptivo" class="relative py-12 lg:py-16">
  <div class="container mx-auto px-4">
    <div class="text-center">
      <div class="flex items-center justify-center mb-6">
        <h2 class="text-3xl lg:text-4xl font-bold text-dark-900 dark:text-white mx-8">
          Translados e <span class="text-primary-600 dark:text-primary-400">Passeios</span>
        </h2>
      </div>
    </div>

    <div class="relative z-20">
      <div>
        <div id="passeios-receptivo-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {passeiosReceptivo.map((passeio, index) => (
            <div data-passeio-card hidden={index >= 4}>
              <div class="bg-white dark:bg-dark-800 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden group h-full flex flex-col">
                <div class="relative h-44 overflow-hidden">
                  <img 
                    src={passeio.image} 
                    alt={passeio.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute top-3 left-3">
                    <span class="bg-accent-500 text-dark-950 px-2 py-1 rounded-full text-xs font-semibold">
                      {passeio.category}
                    </span>
                  </div>
                </div>

                <div class="p-4 flex-1 flex flex-col">
                  <div class="mb-3">
                    <h3 class="font-bold text-dark-900 dark:text-white text-lg mb-1 group-hover:text-primary-600 transition-colors">
                      {passeio.title}
                    </h3>
                    <p class="text-dark-600 dark:text-dark-400 text-sm">
                      {passeio.subtitle}
                    </p>
                  </div>

                  <div class="mt-auto pt-3 border-t border-dark-100 dark:border-dark-700 space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                    {[{label:passeio.label1,preco:passeio.price1}, ...('price3' in passeio ? [{label:passeio.label3,preco:passeio.price3}] : []), {label:passeio.label2,preco:passeio.price2}].map((faixa) => (
                      <div class="bg-dark-50 dark:bg-dark-700/50 rounded-lg p-2 text-center">
                        <p class="text-xs text-dark-500 dark:text-dark-400 font-medium">{faixa.label}</p>
                        <p class="text-lg font-bold text-primary-600 mt-1">{faixa.preco.toLocaleString('pt-BR', {style:'currency',currency:'BRL'})}</p>
                      </div>
                    ))}
                  </div>
                    <a href={`/passeio/${passeio.slug}`} class="w-full bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 px-4 rounded-xl transition-colors duration-200 block text-center text-base shadow-md">RESERVE AGORA</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <div class="flex flex-wrap justify-center gap-4 mt-8 pb-4 relative z-20">
      <button
        id="ver-mais-passeios-receptivo"
        type="button"
        aria-controls="passeios-receptivo-grid"
        hidden={passeiosReceptivo.length <= 4}
        class="bg-primary-700 hover:bg-primary-800 text-white font-bold py-3 px-[30px] rounded-full transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
      >
        Ver mais <span class="ml-3" aria-hidden="true">&#8594;</span>
      </button>
      <button
        id="ver-menos-passeios-receptivo"
        type="button"
        aria-controls="passeios-receptivo-grid"
        hidden
        class="bg-primary-700 hover:bg-primary-800 text-white font-bold py-3 px-[30px] rounded-full transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
      >
        Ver menos <span class="ml-3" aria-hidden="true">&#8593;</span>
      </button>
    </div>
  </div>

</section>

<script>
  function initPasseiosReceptivo() {
    const grid = document.getElementById('passeios-receptivo-grid');
    const moreButton = document.getElementById('ver-mais-passeios-receptivo');
    const lessButton = document.getElementById('ver-menos-passeios-receptivo');
    if (!grid || !moreButton || !lessButton || moreButton.dataset.initialized) return;

    moreButton.dataset.initialized = 'true';
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-passeio-card]'));
    let visibleCount = cards.filter((card) => !card.hidden).length;

    function updateCards() {
      cards.forEach((card, index) => { card.hidden = index >= visibleCount; });
      moreButton.hidden = visibleCount >= cards.length;
      lessButton.hidden = visibleCount <= 4;
    }

    moreButton.addEventListener('click', () => {
      visibleCount = Math.min(cards.length, visibleCount + 4);
      updateCards();
      if (moreButton.hidden) lessButton.focus({ preventScroll: true });
    });

    lessButton.addEventListener('click', () => {
      visibleCount = Math.max(4, visibleCount - 4);
      updateCards();
      if (lessButton.hidden) moreButton.focus({ preventScroll: true });
    });
  }

  initPasseiosReceptivo();
  document.addEventListener('astro:page-load', initPasseiosReceptivo);
</script>
